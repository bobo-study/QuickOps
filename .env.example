# Required. QuickOps fails closed when either login value is missing.
QUICKOPS_AUTH_USERNAME=operator
QUICKOPS_AUTH_PASSWORD=replace-with-a-long-random-password

# Optional. Login session lifetime; all sessions are invalidated whenever the API restarts.
QUICKOPS_AUTH_SESSION_TTL_HOURS=12

# Optional initial model bootstrap. Model credentials can also be managed in QuickOps Settings.
SILICONFLOW_API_KEY=
